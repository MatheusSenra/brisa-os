#!/bin/sh
# Brisa OS: inicialização.
# Só o que a interface precisa roda em primeiro plano. Rede, udev, áudio e
# o resto dos módulos sobem em segundo plano enquanto a lista já aparece.
export PATH=/usr/sbin:/usr/bin:/sbin:/bin

mountpoint -q /proc || mount -t proc proc /proc
mountpoint -q /sys || mount -t sysfs sysfs /sys
mountpoint -q /dev || mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/pts /dev/shm
mount -t devpts devpts /dev/pts 2>/dev/null
mount -t tmpfs -o mode=1777,nosuid,nodev tmpfs /dev/shm 2>/dev/null
mount -t tmpfs -o mode=0755,nosuid,nodev tmpfs /run
mount -t tmpfs -o mode=1777,nosuid,nodev tmpfs /tmp
mount -o remount,rw,noatime /
hostname -F /etc/hostname
mkdir -p /run/brisa

. /usr/lib/brisa/common.sh

# Módulos de vídeo e controles, na ordem em que o firmware stock carrega.
for m in $MODULES_EARLY; do
	modprobe "$m" 2>/dev/null
done

# ---------- cartões ----------

# Disco onde está o rootfs (ex.: mmcblk0), achado pelo major:minor de /.
root_disk() {
	majmin=$(awk '$5 == "/" { print $3; exit }' /proc/self/mountinfo)
	part=$(readlink "/sys/dev/block/$majmin")
	part=${part%/*}
	echo "${part##*/}"
}

fs_type() {
	blkid "$1" 2>/dev/null | sed -n 's/.* TYPE="\([^"]*\)".*/\1/p'
}

# A maior partição FAT/exFAT do disco é a de dados.
data_part() {
	best=
	bsz=0
	for p in /sys/class/block/"$1"/"$1"p*; do
		[ -e "$p" ] || continue
		n=${p##*/}
		case "$(fs_type "/dev/$n")" in
		vfat|exfat) ;;
		*) continue ;;
		esac
		sz=$(cat "$p/size")
		if [ "$sz" -gt "$bsz" ]; then
			best=$n
			bsz=$sz
		fi
	done
	echo "$best"
}

mount_data() {
	mkdir -p "$2"
	case "$(fs_type "/dev/$1")" in
	vfat) mount -t vfat -o rw,noatime,utf8,flush "/dev/$1" "$2" 2>/dev/null ||
		mount -t vfat "/dev/$1" "$2" ;;
	*) mount -o rw,noatime "/dev/$1" "$2" ;;
	esac
}

ROOT_DISK=$(root_disk)

# Primeiro boot num cartão maior que a imagem: cria a partição BRISA (exFAT) com
# o resto do cartão e muda para ela o que já estiver na partição da Anbernic.
if brisa-expand --check "/dev/$ROOT_DISK"; then
	brisa-ui --splash "Preparando o cartão..."
	OLD=$(data_part "$ROOT_DISK")
	NEW=$(brisa-expand "/dev/$ROOT_DISK" 2>> /tmp/expand.log)
	if [ -n "$NEW" ] && [ -n "$OLD" ]; then
		mkdir -p /mnt/old
		if mount_data "$OLD" /mnt/old && mount_data "${NEW#/dev/}" /mnt/sd1; then
			for d in Roms Brisa; do
				[ -d "/mnt/old/$d" ] || continue
				# apaga o original só se a cópia terminou
				cp -r "/mnt/old/$d" /mnt/sd1/ && rm -rf "/mnt/old/$d"
			done
			sync
		fi
		umount /mnt/sd1 2>/dev/null
		umount /mnt/old 2>/dev/null
	fi
fi

P1=$(data_part "$ROOT_DISK")
if [ -n "$P1" ] && mount_data "$P1" /mnt/sd1; then
	BRISA_DATA=/mnt/sd1/Brisa
	BRISA_ROMS=/mnt/sd1/Roms
else
	# sem partição de dados: usa o próprio rootfs
	BRISA_DATA=/data/Brisa
	BRISA_ROMS=/data/Roms
fi

# Pasta de ROMs de um cartão: Roms/ se existir; senão a raiz, se ela já tiver
# pastas de sistemas (coleções copiadas assim: GBA/, SNES/, PS/...); senão Roms/.
roms_dir() {
	[ -d "$1/Roms" ] && { echo "$1/Roms"; return; }
	for dir in $(grep -v '^#' /etc/brisa/systems.conf | cut -d'|' -f3 | tr ',' ' '); do
		[ -d "$1/$dir" ] && { echo "$1"; return; }
	done
	echo "$1/Roms"
}

# Segundo cartão (TF2): se existir, as ROMs ficam nele.
for d in /sys/class/block/mmcblk*; do
	n=${d##*/}
	case "$n" in *p[0-9]*|"$ROOT_DISK"|*boot*|*rpmb*) continue ;; esac
	p2=$(data_part "$n")
	[ -z "$p2" ] && [ -n "$(fs_type "/dev/$n")" ] && p2=$n
	if [ -n "$p2" ] && mount_data "$p2" /mnt/sd2; then
		BRISA_ROMS=$(roms_dir /mnt/sd2)
		break
	fi
done

printf 'BRISA_DATA=%s\nBRISA_ROMS=%s\n' "$BRISA_DATA" "$BRISA_ROMS" > /run/brisa/env
export BRISA_DATA BRISA_ROMS

# ---------- primeiro uso ----------

mkdir -p "$BRISA_ROMS" "$BRISA_DATA"/saves "$BRISA_DATA"/states "$BRISA_DATA"/bios \
	"$BRISA_DATA"/screenshots "$BRISA_DATA"/retroarch
if [ ! -f "$BRISA_DATA/.criado" ]; then
	# uma pasta por sistema, com o primeiro nome listado em systems.conf,
	# só se nenhum dos nomes aceitos já existir (o stock já traz FC, SFC, SMS...)
	grep -v '^#' "$BRISA_ETC/systems.conf" | cut -d'|' -f3 | while read -r dirs; do
		found=
		for dir in $(echo "$dirs" | tr ',' ' '); do
			[ -d "$BRISA_ROMS/$dir" ] && found=1
		done
		[ -z "$found" ] && [ -n "$dirs" ] && mkdir -p "$BRISA_ROMS/${dirs%%,*}"
	done
	cp /usr/share/brisa/wifi.conf.exemplo /usr/share/brisa/LEIA-ME.txt "$BRISA_DATA"/ 2>/dev/null
	touch "$BRISA_DATA/.criado"
fi
brisa_retroarch_prepare

# ---------- segundo plano ----------
(
	for m in $MODULES_LATE; do
		modprobe "$m"
	done
	if command -v udevd >/dev/null; then
		udevd --daemon
		udevadm trigger --action=add
		udevadm settle -t 5
	fi
	# volume salvo no último desligamento; na primeira vez, 24 de 31
	alsactl restore -f "$BRISA_DATA/asound.state" 2>/dev/null ||
		amixer -q -c "$AUDIO_CARD" cset name="$AUDIO_CONTROL" 24 2>/dev/null
	brisa_audio_route
	brisa_set_governor "$(brisa_gov_dynamic)"
	/usr/bin/brisa-net apply

	# Modo desenvolvedor: Brisa/dev/boot.sh no cartão roda como root a cada boot,
	# com a saída em Brisa/logs. Serve para diagnosticar e testar correções sem
	# regravar a imagem. Só existe se alguém criar o arquivo.
	if [ -f "$BRISA_DATA/dev/boot.sh" ]; then
		mkdir -p "$BRISA_DATA/logs"
		sh "$BRISA_DATA/dev/boot.sh" > "$BRISA_DATA/logs/dev-boot.log" 2>&1
		sync
	fi
) > /tmp/boot.log 2>&1 &
