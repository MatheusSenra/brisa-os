# Brisa OS - Anbernic RG35XX H (Allwinner H700, 4x Cortex-A53, Mali-G31)
BR2_aarch64=y
BR2_cortex_a53=y

# Toolchain glibc: os blobs do firmware stock (Mali) são linkados contra glibc
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y

# O kernel continua sendo o 4.9 da Anbernic, então os headers precisam ser 4.9
BR2_KERNEL_HEADERS_VERSION=y
BR2_DEFAULT_KERNEL_VERSION="4.9.337"
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_4_9=y

BR2_OPTIMIZE_2=y

# Sistema
BR2_TARGET_GENERIC_HOSTNAME="brisa"
BR2_TARGET_GENERIC_ISSUE="Brisa OS"
BR2_TARGET_GENERIC_ROOT_PASSWD="brisa"
BR2_INIT_BUSYBOX=y
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_BRISA_PATH)/board/rg35xxh/busybox.fragment"
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y
BR2_TARGET_GENERIC_GETTY_PORT="ttyS0"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_BRISA_PATH)/board/rg35xxh/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_BRISA_PATH)/board/rg35xxh/post-build.sh"

# Fonte da interface
BR2_PACKAGE_DEJAVU=y
# BR2_PACKAGE_DEJAVU_MONO is not set
# BR2_PACKAGE_DEJAVU_SERIF is not set
# BR2_PACKAGE_DEJAVU_SANS_CONDENSED is not set
# BR2_PACKAGE_DEJAVU_SERIF_CONDENSED is not set

# Áudio
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_UTILS_ALSACTL=y
BR2_PACKAGE_ALSA_UTILS_AMIXER=y
BR2_PACKAGE_ALSA_UTILS_APLAY=y

# Armazenamento e módulos
# sfdisk/partx: criam a partição BRISA com o resto do cartão no primeiro boot
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_BINARIES=y
BR2_PACKAGE_UTIL_LINUX_PARTX=y
BR2_PACKAGE_DOSFSTOOLS=y
BR2_PACKAGE_DOSFSTOOLS_FSCK_FAT=y
BR2_PACKAGE_EXFATPROGS=y
BR2_PACKAGE_KMOD=y
BR2_PACKAGE_KMOD_TOOLS=y

# Rede: Wi-Fi e SSH/SFTP
# (o rsync 3.4 precisa de headers do kernel >= 5.6 e não compila para o 4.9)
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_PACKAGE_WPA_SUPPLICANT_PASSPHRASE=y
BR2_PACKAGE_IW=y
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_GESFTPSERVER=y

# Brisa
BR2_PACKAGE_BRISA_UI=y
BR2_PACKAGE_BRISA_VENDOR=y
BR2_PACKAGE_BRISA_MALI=y
BR2_PACKAGE_BRISA_RETROARCH=y
BR2_PACKAGE_LIBRETRO_FCEUMM=y
BR2_PACKAGE_LIBRETRO_GAMBATTE=y
BR2_PACKAGE_LIBRETRO_MGBA=y
BR2_PACKAGE_LIBRETRO_PCSX_REARMED=y
BR2_PACKAGE_LIBRETRO_PICODRIVE=y
BR2_PACKAGE_LIBRETRO_SNES9X=y

# Saída: tar do rootfs; a imagem final é montada por scripts/build-image.sh
BR2_TARGET_ROOTFS_TAR=y
